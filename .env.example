# Gmail Configuration for Contact Form
# This file contains environment variables needed for the email backend

# Gmail address (must be a Gmail account)
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# To generate an App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Factor Authentication if you haven't already
# 3. Go to "App passwords" in the Security section
# 4. Select "Mail" and "Windows Computer" (or your platform)
# 5. Copy the 16-character password and paste it below
GMAIL_PASSWORD=your-16-char-app-password
